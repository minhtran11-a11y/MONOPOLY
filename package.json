{
  "name": "monopoly-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node verify_runtime.cjs",
    "verify:gameplay": "node verify_gameplay.cjs",
    "verify:e2e": "start-server-and-test \"vite preview --port 8770 --strictPort\" http://127.0.0.1:8770 \"node verify_runtime.cjs\"",
    "lighthouse": "node run_lighthouse.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "canvas-confetti": "^1.9.4",
    "cannon-es": "0.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.128.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "chrome-launcher": "^1.2.0",
    "lighthouse": "^12.8.0",
    "postcss": "^8.4.0",
    "start-server-and-test": "^2.0.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "ws": "^8.20.0"
  }
}
